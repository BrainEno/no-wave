# Keep generated font data out of the default PR code review; source recipes,
# verification tests and the original OFL licenses remain visible.
packages/web-ui/src/styles/fonts/*.woff2 binary linguist-generated=true
packages/web-ui/src/styles/fonts/manifest.json text eol=lf linguist-generated=true
packages/web-ui/src/styles/fonts.css text eol=lf linguist-generated=true

# Original upstream licenses are authenticated byte-for-byte, including their
# trailing spaces. Never reformat those notices to satisfy a source-code check.
packages/web-ui/src/styles/fonts/*-OFL.txt text eol=lf whitespace=-blank-at-eol

# Deterministic font subsetting priority receipts must retain exact LF line endings across platforms.
scripts/fonts/noto-reading-priority.json text eol=lf
