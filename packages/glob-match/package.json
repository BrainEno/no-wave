{
  "name": "@no-wave/glob-match",
  "version": "0.0.0",
  "private": true,
  "description": "Internal build-tool glob adapter using minimatch's non-recursive matching engine; not a picomatch distribution",
  "type": "commonjs",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/utils": "./src/utils.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@isaacs/nonrecursive-glob-match": "1.1.0",
    "minimatch": "11.0.9"
  }
}
