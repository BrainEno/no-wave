{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "apps/api/Dockerfile.vercel"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_SERVICE_URL"
        }
      ]
    }
  },
  "daemons": {
    "notifications": {
      "root": ".",
      "entrypoint": "apps/api/Dockerfile.vercel",
      "command": [
        "node",
        "apps/api/src/persistence/notification-worker.ts"
      ],
      "instances": {
        "hkg1": 1
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
