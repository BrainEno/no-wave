# Safe template only. Copy to ignored .env.local and fill from Neon CLI.
# Never commit .env.local or real database/storage/JWT credentials.
DATABASE_PROVIDER=postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required by the existing self-hosted JWT authentication implementation.
# Replace the issuer with the stable public API/app origin in production.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=http://localhost:4000
AUTH_JWT_AUDIENCE=no-wave
AUTH_JWT_MAX_TTL_SECONDS=900

# Local Web -> standalone API. Vercel uses the API_SERVICE_URL service binding.
API_BASE_URL=http://localhost:4000

# Must match the private bucket declared in neon.ts.
MEDIA_S3_BUCKET=media
# Neon env pull provides AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# and AWS_ENDPOINT_URL_S3. The application accepts these standard names.
# For Neon, path-style addressing is required:
MEDIA_S3_FORCE_PATH_STYLE=true
# Optional MEDIA_S3_* overrides (take precedence over AWS_*):
# MEDIA_S3_REGION=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_ENDPOINT=
