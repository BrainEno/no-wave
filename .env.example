# Local development environment template.
#
# Copy to `.env.local` in the repository root, or let `pnpm setup:local` write it
# with a generated AUTH_JWT_SECRET:
#
#     pnpm setup:local              # SQLite (default)
#     pnpm setup:local --postgres   # Docker PostgreSQL from compose.yaml
#
# Root `.env.local` is read by BOTH processes: the API through
# `node --env-file-if-exists`, and the Web dev server through
# `apps/web/next.config.ts` (`process.loadEnvFile`). A shell export always wins
# over the file.
#
# Never commit `.env.local`, and never put shared staging/production credentials
# in it. See docs/development/local-development.md.

# --- Persistence -------------------------------------------------------------
# SQLite is the default for local development (ADR 0010). `DATABASE_PATH` is
# resolved relative to apps/api, so the default file lives at
# apps/api/data/no-wave.sqlite.
DATABASE_PROVIDER=sqlite
DATABASE_PATH=data/no-wave.sqlite

# Apply SQLite migrations during API startup instead of `pnpm db:migrate`.
# Local/test convenience only; leave unset for anything remotely important.
# DATABASE_AUTO_MIGRATE=true

# PostgreSQL alternative for local development. Start it with `pnpm db:up`
# (compose.yaml starts PostgreSQL 17 with the bot_thk_dev and bot_thk_test
# databases), then set DATABASE_PROVIDER and DATABASE_URL and run
# `pnpm db:migrate`. A DATABASE_URL without DATABASE_PROVIDER still selects
# PostgreSQL for backwards compatibility with existing deployments.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bot_thk_dev
# `pnpm db:migrate` prefers this URL for migrations when it is set (Neon direct
# connection); normal query traffic uses DATABASE_URL.
# DATABASE_URL_UNPOOLED=
# Optional: enables the PostgreSQL integration tests inside `pnpm test`
# (`pnpm db:up` creates this database).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bot_thk_test

# --- API process -------------------------------------------------------------
# HOST=0.0.0.0 lets a container, a LAN device or a preview proxy reach the API;
# use 127.0.0.1 to keep it on the local machine.
HOST=0.0.0.0
PORT=4000

# Required by the self-hosted JWT implementation. The API rejects anything
# shorter than 32 bytes; the REST layer then answers 503 SERVICE_UNAVAILABLE,
# which looks like an outage. Generate one with `pnpm setup:local`.
AUTH_JWT_SECRET=
# Replace the issuer with the stable public API/app origin in production.
AUTH_JWT_ISSUER=http://localhost:4000
AUTH_JWT_AUDIENCE=no-wave
AUTH_JWT_MAX_TTL_SECONDS=900

# How many accounts one address may create in an hour. Registration is the only
# unauthenticated write that creates rows, and behind the Web proxy every browser
# shares an address, so the default is deliberately tight (20). Raise it only for
# a deployment whose readers legitimately share one address — a value that does
# not parse, or that would switch the throttle off, falls back to the default.
# AUTH_REGISTER_IP_LIMIT=20

# How many days a deleted work stays recoverable before the sweep removes it for
# good. An out-of-range value falls back to the default (30) rather than being
# clamped, so a typo can never shorten the window.
# ARTICLE_TOMBSTONE_RETENTION_DAYS=30

# --- Outbound mail (recovery + verification) ---------------------------------
# The switch for every feature that would put mail in somebody's inbox.
#
# Off by default, and read by BOTH processes: the API refuses the endpoints that
# send a link (409 MAIL_DISABLED), and the Web app stops offering the pages and
# buttons that lead to them. One variable, one answer, no half-enabled state.
# Unset, empty and unrecognised values all mean off — a typo must not switch
# mail on.
#
# The code for recovery and verification ships complete; this is the operator's
# decision, and nothing is sent until it is taken. Full procedure — what is off,
# how to turn it on once you have a relay, how to tell from the logs:
# docs/operations/mail-setup.md.
#
# With mail off nothing is broken: accounts register, sign in, write and publish
# exactly as before. Email verification is a stamp, not a gate (ADR 0014), and
# password recovery is the only feature that genuinely cannot work without a
# relay.
#
# Read at request time, not build time, so switching it does not need a rebuild
# (the three recovery pages are `force-dynamic` for exactly that reason — as
# static prerenders they were frozen with whichever value the build had).
# MAIL_ENABLED=false
#
# Without MAIL_ENABLED (or without MAIL_SMTP_HOST and MAIL_FROM), the API logs
# account mail instead of sending it: see ADR 0015. Plain SMTP submission, so
# any relay works.
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# starttls (default) | implicit (465) | none (local relay only)
# MAIL_SMTP_SECURITY=starttls
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# Total budget for one delivery, retries included (default 2000, max 10000).
# MAIL_SMTP_DELIVERY_DEADLINE_MS=
# MAIL_FROM=
# MAIL_FROM_NAME=

# --- Web dev server ----------------------------------------------------------
# Server-side origin the Web app calls. Use 127.0.0.1 rather than localhost:
# localhost may resolve to IPv6 ::1 while the API listens on IPv4 only.
# Vercel injects API_SERVICE_URL from its service binding instead.
API_BASE_URL=http://127.0.0.1:4000
WEB_PORT=3000
# HOST=0.0.0.0 by default; set 127.0.0.1 to keep the dev server local.
# WEB_HOST=0.0.0.0
# Next.js only serves development assets to trusted hostnames. Add LAN or
# preview hostnames (comma separated) when you open the dev server from another
# device, otherwise styles and hydration are rejected.
# WEB_DEV_ALLOWED_ORIGINS=192.168.1.10:3000,*.preview.example

# --- Media uploads (optional) ------------------------------------------------
# Uploads are disabled until all four required values are present.
# See docs/operations/web-authoring.md.
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_FORCE_PATH_STYLE=true
# Neon's `env pull` provides the AWS_* equivalents instead:
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=

# --- Observability (optional) -----------------------------------------------
# Exposes Prometheus metrics at http://127.0.0.1:4000/metrics.
# API_METRICS_ENABLED=true
