# Local development environment template.
#
# Copy to `.env.local` in the repository root, or let `pnpm setup:local` write it
# with a generated AUTH_JWT_SECRET:
#
#     pnpm setup:local              # SQLite (default)
#     pnpm setup:local --postgres   # Docker PostgreSQL from compose.yaml
#
# Root `.env.local` is shared by API, notification worker and Web. The API/worker use
# `node --env-file-if-exists`; the Web dev server uses
# `apps/web-rr/vite.config.ts` (`process.loadEnvFile`). A shell export always wins
# over the file.
#
# Never commit `.env.local`, and never put shared staging/production credentials
# in it. See docs/development/local-development.md.

# --- Site -------------------------------------------------------------------
# The public origin of the site. Canonical URLs, hreflang alternates, sitemap
# entries and the links inside account mail are built from it, so it must be the
# origin visitors actually use (scheme and host, no trailing slash).
#
# `SITE_URL` is the name this project uses. `NEXT_PUBLIC_SITE_URL` is the
# Next.js-era one and is still read as a fallback, so a deployment that has it
# set keeps working; new environments should use `SITE_URL`.
#
# Nothing is inlined at build time: the React Router app reads it per request, so
# changing it needs a restart rather than a rebuild. Set it in every environment,
# including preview deployments — an unset value falls back to a placeholder that
# no crawler should be given.
# SITE_URL=
# NEXT_PUBLIC_SITE_URL= # compatibility only; SITE_URL takes precedence

# --- Persistence -------------------------------------------------------------
# LOCAL DEVELOPMENT: use SQLite below, or the throwaway Docker PostgreSQL from
# compose.yaml. Do not paste Neon's pooled/unpooled DATABASE_URL here: local
# probes write data, and repeating them against a managed branch wastes quota.
# `pnpm setup:local --postgres` ignores external DATABASE_URL values inherited
# from the shell and writes the local compose URL instead.
#
# SQLite is the default for local development (ADR 0010). `DATABASE_PATH` is
# resolved relative to apps/api, so the default file lives at
# apps/api/data/no-wave.sqlite.
DATABASE_PROVIDER=sqlite
DATABASE_PATH=data/no-wave.sqlite

# Apply SQLite migrations during API startup instead of `pnpm db:migrate`.
# Local/test convenience only; leave unset for anything remotely important.
# DATABASE_AUTO_MIGRATE=true

# PostgreSQL alternative for local development. Start it with `pnpm db:up`
# (compose.yaml starts PostgreSQL 17 with the bot_thk_dev and bot_thk_test
# databases), then set DATABASE_PROVIDER and DATABASE_URL and run
# `pnpm db:migrate`. A DATABASE_URL without DATABASE_PROVIDER still selects
# PostgreSQL for backwards compatibility with existing deployments.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bot_thk_dev
# Deployment-only: `pnpm db:migrate` prefers this URL when it is set (for
# example Neon's direct connection). Do not set it for routine local development;
# normal query traffic uses DATABASE_URL.
# DATABASE_URL_UNPOOLED=
# Optional: enables the PostgreSQL integration tests inside `pnpm test`
# (`pnpm db:up` creates this database).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bot_thk_test

# --- API process -------------------------------------------------------------
# HOST=0.0.0.0 lets a container, a LAN device or a preview proxy reach the API;
# use 127.0.0.1 to keep it on the local machine.
HOST=0.0.0.0
PORT=4000

# Required by the self-hosted JWT implementation. The API rejects anything
# shorter than 32 bytes; the REST layer then answers 503 SERVICE_UNAVAILABLE,
# which looks like an outage. Generate one with `pnpm setup:local`.
AUTH_JWT_SECRET=
# Replace the issuer with the stable public API/app origin in production.
AUTH_JWT_ISSUER=http://localhost:4000
AUTH_JWT_AUDIENCE=no-wave
AUTH_JWT_MAX_TTL_SECONDS=900

# How many accounts one address may create in an hour. Registration is the only
# unauthenticated write that creates rows, and behind the Web proxy every browser
# shares an address, so the default is deliberately tight (20). Raise it only for
# a deployment whose readers legitimately share one address — a value that does
# not parse, or that would switch the throttle off, falls back to the default.
# AUTH_REGISTER_IP_LIMIT=20

# How many days a deleted work stays recoverable before the sweep removes it for
# good. An out-of-range value falls back to the default (30) rather than being
# clamped, so a typo can never shorten the window.
# ARTICLE_TOMBSTONE_RETENTION_DAYS=30

# --- Editorial roles (optional) ---------------------------------------------
# Comma-separated user IDs that are editors whatever `user_profiles.role` says.
# This is how an empty database gets its first editor: only an editor may write
# the column, so without an outside way in the role system cannot start. It is
# also the way back in if the last editor account is lost. Changing it needs a
# restart; changing the column does not. See ADR 0016.
# EDITOR_USER_IDS=

# --- Outbound mail (recovery + verification) ---------------------------------
# The switch for every feature that would put mail in somebody's inbox.
#
# Off by default, and read by BOTH processes: the API refuses the endpoints that
# send a link (409 MAIL_DISABLED), and the Web app stops offering the pages and
# buttons that lead to them. One variable, one answer, no half-enabled state.
# Unset, empty and unrecognised values all mean off — a typo must not switch
# mail on.
#
# The code for recovery and verification ships complete; this is the operator's
# decision, and nothing is sent until it is taken. Full procedure — what is off,
# how to turn it on once you have a relay, how to tell from the logs:
# docs/operations/mail-setup.md.
#
# With mail off nothing is broken: accounts register, sign in, write and publish
# exactly as before. Email verification is a stamp, not a gate (ADR 0014), and
# password recovery is the only feature that genuinely cannot work without a
# relay.
#
# Read at request time, not build time, so switching it does not need a rebuild
# (the three recovery pages are `force-dynamic` for exactly that reason — as
# static prerenders they were frozen with whichever value the build had).
# MAIL_ENABLED=false
#
# Without MAIL_ENABLED (or without MAIL_SMTP_HOST and MAIL_FROM), the API logs
# account mail instead of sending it: see ADR 0015. Plain SMTP submission, so
# any relay works.
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# starttls (default) | implicit (465) | none (local relay only)
# MAIL_SMTP_SECURITY=starttls
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# Total budget for one delivery, retries included (default 2000, max 10000).
# MAIL_SMTP_DELIVERY_DEADLINE_MS=
# MAIL_FROM=
# MAIL_FROM_NAME=

# --- Visitor address provenance (Web + API, ADR 0027) -------------------------
# Without a shared key the API sees the BFF's socket, so visitors share IP
# quotas and anonymous view dedupe. Configure the SAME separate random key on
# both processes to enable the authenticated bridge; never reuse AUTH_JWT_SECRET.
# Unset/empty disables it. A configured key must be 32-512 non-whitespace ASCII
# characters; use >=32 random bytes encoded as hex and keep it server-only.
# BFF_CLIENT_ADDRESS_SECRET=
# In bridge mode the API MUST keep this at 0 (nonzero fails startup). Without
# the bridge, legacy direct-API proxy deployments may explicitly use 0-5 hops.
# TRUSTED_PROXY_HOPS=0
# Web: 0 for a directly observed visitor; 1-5 only for a reviewed proxy chain.
# Nonzero requires named socket/intermediate peers below. Every ingress must
# append its observed peer or overwrite client-supplied forwarding input.
# HSTS also uses this policy, independently of BFF signing: every trusted proxy
# must append the matching observed http/https value to X-Forwarded-Proto.
# Unknown peers, malformed/incomplete suffixes and plain HTTP never grant HSTS.
# SITE_URL/Host/Forwarded are not TLS evidence. See ADR 0039.
# WEB_TRUSTED_PROXY_HOPS=0
# Comma-separated literal IPs/CIDRs; all intermediate proxies must match.
# No /0, hostnames or zone IDs. Never use a broad range just to pass a check.
# WEB_TRUSTED_PROXY_PEERS=
# Missing/invalid proofs fall back to the API socket, not browser XFF. Synchronize
# clocks (30s skew) and verify two real client IPs, not only /healthz.
# docs/operations/portable-stack.md#visitor-address-provenance

# --- Web refresh coordination (ADR 0025) -------------------------------------
# Declare the real replica count. More than one Web process MUST use postgres;
# memory + WEB_INSTANCE_COUNT>1 refuses startup, even behind sticky routing.
# The API can still use SQLite. The separate Web ledger needs PostgreSQL with
# session-capable connections, transactions/advisory locks and LISTEN/NOTIFY.
# See docs/operations/web-refresh-coordination.md before enabling this.
# WEB_INSTANCE_COUNT=1
# WEB_REFRESH_COORDINATOR=memory
# Shared mode only; provision through secret management, never paste real keys.
# WEB_REFRESH_DATABASE_URL=
# WEB_REFRESH_ENCRYPTION_KEY=
# WEB_REFRESH_NAMESPACE=default
# Optional protected operations endpoint; a different secret, NOT the AES key.
# WEB_REFRESH_METRICS_TOKEN=
# Explicit operator step before starting replicas: pnpm web:refresh migrate
# Normal startup verifies the existing schema and never performs DDL.

# --- Optional finite durable Notion imports (API process only) ----------------
# Default OFF. No API queue executor, Notion credential custody or UI migration.
# Read docs/operations/notion-import-jobs.md before provisioning keys/enabling.
NOTION_IMPORT_JOBS_ENABLED=false
# Configure EITHER the single canonical-base64 32-byte key OR the named ring.
# Never reuse the JWT/refresh/metrics/Notion secret. Do not paste real keys in logs.
# NOTION_IMPORT_JOB_KEY=
# Named ring: at most 3 id:base64 entries, comma separated; active id is required.
# Keep the id "primary" when carrying a single-key input into a ring.
# NOTION_IMPORT_JOB_KEYS=
# NOTION_IMPORT_JOB_ACTIVE_KEY=
# Independent one-shot jobs:notion drain, not a new long-running server role.
# NOTION_IMPORT_DRAIN_MAX_JOBS=1
# NOTION_IMPORT_DRAIN_DEADLINE_MS=300000
# inspect/sweep need no key. check needs keys + API signing settings, not enablement.

# --- Web dev server ----------------------------------------------------------
# Server-side origin the Web app calls. Use 127.0.0.1 rather than localhost:
# localhost may resolve to IPv6 ::1 while the API listens on IPv4 only.
# Vercel injects API_SERVICE_URL from its service binding instead.
API_BASE_URL=http://127.0.0.1:4000
# Compatibility-only runtime inputs, never browser API URLs. API_BASE_URL wins;
# API_GRAPHQL_URL (/graphql removed) precedes API_SERVICE_URL when it is absent.
# Keep deployed aliases until their owner has confirmed migration.
# API_GRAPHQL_URL=
# API_SERVICE_URL=
# Native production server resolves these relative to apps/web-rr's cwd.
# RR_BUILD_DIR=build/client
# RR_SERVER_BUILD_DIR=build/server/index.js
# PORT=3100
# HOST=0.0.0.0
# Budget in milliseconds for one API call the Web tier makes (SSR page reads,
# the BFF proxies, media objects). Default 10000, maximum 120000. A malformed
# value fails closed with the route's own 503 instead of waiting forever.
# See docs/architecture/web-upstream-timeouts.md.
# API_TIMEOUT_MS=10000
# Notion imports retain their default 90000ms when API_TIMEOUT_MS is unset.
# The following are process-local pressure guards, not API domain/rate limits.
# Ordinary upstream lane: active 1..32, queued 0..128, wait 1..5000ms.
# Auth and bulk lanes stay isolated at 2/8 and 1/2 active/queued, 250ms wait.
# WEB_UPSTREAM_CONCURRENCY=8
# WEB_UPSTREAM_QUEUE=32
# WEB_UPSTREAM_QUEUE_TIMEOUT_MS=250
# Optional /internal/upstream-metrics: independent opaque 43..128 URL-safe chars,
# never reuse refresh metrics/AES/JWT/provenance credentials; absent means 404.
# WEB_UPSTREAM_METRICS_TOKEN=
# Native HTTP intake: ordinary exchanges 1..256; session lane reserves 8 more.
# Body reservations 9MiB..128MiB; route/API body limits are unchanged.
# WEB_REQUEST_CONCURRENCY=56
# WEB_REQUEST_BODY_BUDGET_BYTES=67108864
# Whole incoming HTTP message 1000..120000ms; headers <= message deadline.
# Body readers also have their separate 30000ms deadline; no upload idle forever.
# WEB_REQUEST_TIMEOUT_MS=60000
# WEB_HEADERS_TIMEOUT_MS=15000
# Native keep-alive timeout 100..60000ms. Checked by Node, not an API-call timeout.
# WEB_KEEP_ALIVE_TIMEOUT_MS=5000
WEB_PORT=3000
# HOST=0.0.0.0 by default; set 127.0.0.1 to keep the dev server local.
# WEB_HOST=0.0.0.0
# Vite dev allowed hosts (comma separated); empty permits preview/LAN hosts.
# Production server has no Vite host filter; proxy/Origin security is separate.
# WEB_DEV_ALLOWED_ORIGINS=192.168.1.10:3000,*.preview.example

# --- Media uploads (optional) ------------------------------------------------
# Uploads are disabled until all four required values are present.
# See docs/operations/web-authoring.md.
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_FORCE_PATH_STYLE=true
# Neon's `env pull` provides the AWS_* equivalents instead:
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
#
# Deleting a stored image through `DELETE /api/v1/me/media/:id` is OFF unless
# this is one of true/1/yes/on. Unset, empty and unrecognised values all mean
# off — a typo must never switch on the operation that can destroy data.
#
# Why off: it is a destructive operation on stored data, and the default should
# not be "on" for a deployment that never asked for it. The reason it was unsafe
# to enable has been fixed, though: the check-then-delete race under PostgreSQL's
# READ COMMITTED (#156) is closed by a row lock on the asset plus `ON DELETE
# RESTRICT` from the materialised reference table (#163), so an image that is in
# use cannot be deleted even if a concurrent save slips past the check. An
# operator who wants deletion can now turn this on.
#
# The Web app hides the delete button independently, but hiding a button does not
# protect a Flutter build or a direct `curl` — which is why the refusal lives in
# the API. A refused delete answers 409 `MEDIA_DELETE_DISABLED`.
# MEDIA_DELETE_ENABLED=false

# --- Observability (optional) -----------------------------------------------
# Exposes Prometheus metrics at http://127.0.0.1:4000/metrics.
# API_METRICS_ENABLED=true

# --- Service roles, readiness and bounded shutdown (ADR 0040) -----------------
# The API image runs exactly one role. A separate worker container uses the SAME
# migrated persistent file/volume or PostgreSQL database; no API JWT is required
# by the worker. Unknown roles fail startup. Default pnpm dev starts both roles.
# SERVICE_ROLE=api
# Worker anonymous health listener: /health and /ready, NOT business routes or
# /metrics. SERVICE_ROLE=notification-worker enables it at 4001; the direct
# worker script enables it only when OUTBOX_HEALTH_PORT is explicitly set.
# OUTBOX_HEALTH_PORT=4001
# Set 0.0.0.0 only for a restricted container/probe network, not the public net.
# OUTBOX_HEALTH_HOST=127.0.0.1
# Existing worker retry/delivery defaults; all settings are validated before DB.
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_BATCH_LIMIT=25
# OUTBOX_LEASE_SECONDS=60
# OUTBOX_RETRY_DELAY_SECONDS=30
# OUTBOX_MAX_RETRY_DELAY_SECONDS=86400
# OUTBOX_MAX_ATTEMPTS=8
# Optional PRIVATE metrics listener; 0 disables. Health and metrics stay separate.
# OUTBOX_METRICS_PORT=0
# OUTBOX_METRICS_HOST=127.0.0.1
# OUTBOX_METRICS_REFRESH_INTERVAL_MS=5000
# Sampling never blocks dispatch; one query in flight even after a timeout.
# OUTBOX_METRICS_TIMEOUT_MS=500
# API headers <= request timeout; defaults 15000/60000/5000 ms, bounded settings.
# API_HEADERS_TIMEOUT_MS=15000
# API_REQUEST_TIMEOUT_MS=60000
# API_KEEP_ALIVE_TIMEOUT_MS=5000
# Absolute output-only deadline for article collection encoding/drain/finish.
# 100–600000 ms; default 120000. Late failure destroys partial JSON, never a
# successful short page. Independent of API ingress and Web upstream budgets.
# API_COLLECTION_WRITE_TIMEOUT_MS=120000
# Separate admitted collection read/metadata deadline, before the writer starts.
# 100–600000 ms; default 120000. Timeout answers a fixed private 504, but does
# not release the active slot before every parallel database read settles.
# API_COLLECTION_READ_TIMEOUT_MS=120000
# Native API article-collection GET admission; independent of auth/detail/write
# handlers. 1–32 active, 0–128 queued, 1–5000 ms queue wait. Physical handlers
# remain active after a client disconnect until their persistence work settles.
# API_COLLECTION_CONCURRENCY=4
# API_COLLECTION_QUEUE=16
# API_COLLECTION_QUEUE_TIMEOUT_MS=250
# A single coalesced read per dependency; a stalled probe cannot launch a storm.
# API_READINESS_TIMEOUT_MS=500
# API_READINESS_CACHE_MS=1000
# A missing consumer eventually makes API /ready 503, not /health. Dead letters
# are reported separately and do not count as pending. Range 1000..86400000 ms.
# API_OUTBOX_MAX_PENDING_AGE_MS=120000
# One absolute shutdown deadline includes drain AND cleanup. Cleanup must be
# smaller than grace; defaults 8000/2000 ms. Host kill timeout must be larger.
# Startup includes provider acquisition and the worker's first durable batch.
# Expiry fails closed, then uses the normal shutdown budget; range 100..120000.
# SERVICE_STARTUP_TIMEOUT_MS=30000
# SHUTDOWN_GRACE_MS=8000
# SHUTDOWN_CLEANUP_MS=2000
# Development only: after an observed readiness gap, allow hot reload/transient
# recovery before stopping every role. Range 1000..120000 ms; default 15000.
# DEV_RECOVERY_TIMEOUT_MS=15000
