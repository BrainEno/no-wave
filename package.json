{
  "name": "no-wave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup-local.ts --all",
    "setup:local": "node scripts/setup-local.ts",
    "test:all": "node scripts/test-all.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:migrate": "pnpm --filter @no-wave/api migrate",
    "db:transfer": "pnpm --filter @no-wave/api db:transfer",
    "dev": "node scripts/dev.ts",
    "dev:api": "node scripts/dev.ts --api-only",
    "dev:web": "node scripts/dev.ts --web-only",
    "dev:rr": "pnpm --filter @no-wave/web-rr dev",
    "check:local": "node scripts/local-dev-check.ts",
    "verify:publish": "node scripts/verify-publish.ts",
    "notion:seed": "node scripts/notion-seed.ts",
    "fonts:generate": "node scripts/fonts/generate.ts",
    "fonts:prepare": "node scripts/fonts/generate.ts --prepare",
    "fonts:check": "node scripts/fonts/generate.ts --check",
    "perf:baseline": "node scripts/perf-baseline.ts",
    "perf:baseline:quick": "node scripts/perf-baseline.ts --quick",
    "rr:build": "pnpm --filter @no-wave/web-rr build",
    "rr:start": "pnpm --filter @no-wave/web-rr start",
    "stack:start": "node scripts/portable-stack.ts --keep",
    "stack:check": "node scripts/portable-stack.ts",
    "test:web": "pnpm --filter @no-wave/web-rr build && pnpm --filter @no-wave/web-rr test",
    "build": "pnpm --filter @no-wave/web-rr build",
    "typecheck": "pnpm --filter @no-wave/glob-match typecheck && pnpm --filter @no-wave/web-http typecheck && pnpm --filter @no-wave/web-ui typecheck && pnpm --filter @no-wave/web-rr typecheck && pnpm --filter @no-wave/api typecheck && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "pnpm fonts:prepare && node scripts/test.ts root",
    "test:routes": "node scripts/route-smoke.ts",
    "openapi:check": "node scripts/generate-openapi.ts",
    "openapi:write": "node scripts/generate-openapi.ts --write",
    "slices:check": "node scripts/generate-persistence-slices.ts --check",
    "slices:generate": "node scripts/generate-persistence-slices.ts --write",
    "test:container-smoke": "node scripts/container-smoke.ts",
    "test:e2e": "node scripts/e2e-runner.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint:css-vars": "node scripts/check-css-vars.ts",
    "lint:inline-styles": "node scripts/check-inline-styles.ts",
    "lint:inline-copy": "node scripts/check-inline-copy.ts",
    "lint": "pnpm lint:css-vars && pnpm lint:css && pnpm lint:inline-styles && pnpm lint:inline-copy && pnpm lint:typescript",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\" --allow-empty-input",
    "lint:typescript": "node scripts/lint-typescript.ts",
    "knip:deps": "KNIP_DISABLE_RAW_TRANSFER=1 knip --dependencies",
    "knip:report": "KNIP_DISABLE_RAW_TRANSFER=1 knip --no-exit-code",
    "format:check": "prettier --check eslint.config.ts .stylelintrc.json \"scripts/**/*.{ts,cjs}\" \"e2e/**/*.ts\"",
    "format": "prettier --write eslint.config.ts .stylelintrc.json \"scripts/**/*.{ts,cjs}\" \"e2e/**/*.ts\"",
    "test:notification-delivery": "node scripts/notification-delivery-smoke.ts",
    "web:refresh": "node apps/web-rr/refresh/command.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "8.1.2",
    "@no-wave/eslint-typescript": "workspace:*",
    "@no-wave/glob-match": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "fflate": "0.8.3",
    "fontkit": "3.0.0",
    "knip": "6.48.0",
    "marked": "18.2.1",
    "postcss": "8.5.33",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.10.0",
    "stylelint": "18.0.0",
    "subset-font": "2.9.0",
    "typescript": "7.0.2"
  }
}
