{
  "name": "bot-thk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.ts",
    "test:all": "node scripts/test-all.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:migrate": "pnpm --filter @bot-thk/api migrate",
    "db:transfer": "pnpm --filter @bot-thk/api db:transfer",
    "dev": "node scripts/dev.ts",
    "dev:api": "node scripts/dev.ts --api-only",
    "dev:web": "node scripts/dev.ts --web-only",
    "dev:rr": "pnpm --filter @bot-thk/web-rr dev",
    "check:local": "node scripts/local-dev-check.ts",
    "verify:publish": "node scripts/verify-publish.ts",
    "notion:seed": "node scripts/notion-seed.ts",
    "fonts:generate": "node scripts/fonts/generate.ts",
    "fonts:check": "node scripts/fonts/generate.ts --check",
    "perf:baseline": "node scripts/perf-baseline.ts",
    "perf:baseline:quick": "node scripts/perf-baseline.ts --quick",
    "rr:build": "pnpm --filter @bot-thk/web-rr build",
    "rr:start": "pnpm --filter @bot-thk/web-rr start",
    "stack:start": "node scripts/portable-stack.ts --keep",
    "stack:check": "node scripts/portable-stack.ts",
    "test:web": "pnpm --filter @bot-thk/web-rr build && pnpm --filter @bot-thk/web-rr test",
    "build": "pnpm --filter @bot-thk/web-rr build",
    "typecheck": "pnpm --filter @bot-thk/web-http typecheck && pnpm --filter @bot-thk/web-ui typecheck && pnpm --filter @bot-thk/web-rr typecheck && pnpm --filter @bot-thk/api typecheck && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "node scripts/test.ts root",
    "test:routes": "node scripts/route-smoke.ts",
    "openapi:check": "node scripts/generate-openapi.ts",
    "openapi:write": "node scripts/generate-openapi.ts --write",
    "slices:check": "node scripts/generate-persistence-slices.ts --check",
    "slices:generate": "node scripts/generate-persistence-slices.ts --write",
    "test:container-smoke": "node scripts/container-smoke.ts",
    "test:e2e": "node scripts/e2e-runner.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint:css-vars": "node scripts/check-css-vars.ts",
    "lint": "pnpm lint:css-vars && pnpm lint:css && pnpm lint:typescript",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\" --allow-empty-input",
    "lint:typescript": "eslint --flag unstable_native_nodejs_ts_config --no-inline-config --max-warnings 0 \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" eslint.config.ts",
    "format:check": "prettier --check eslint.config.ts .stylelintrc.json scripts/lint-policy.test.ts",
    "format": "prettier --write eslint.config.ts .stylelintrc.json scripts/lint-policy.test.ts",
    "test:notification-delivery": "node scripts/notification-delivery-smoke.ts",
    "web:refresh": "node apps/web-rr/refresh/command.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@babel/parser": "7.29.11",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "fontkit": "3.0.0",
    "marked": "18.1.3",
    "postcss": "8.5.32",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.10.0",
    "stylelint": "17.4.0",
    "subset-font": "2.9.0",
    "typescript": "7.0.2"
  }
}
