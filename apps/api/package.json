{
  "name": "@bot-thk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone versioned REST API with SQLite-first, provider-independent persistence",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/server.ts",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --watch src/server.ts",
    "migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/persistence/migrate.ts",
    "db:transfer": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/persistence/db-transfer.ts",
    "worker:notifications": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/persistence/notification-worker.ts",
    "ops:monitor": "node src/infrastructure/monitor-command.ts",
    "ops:handoff": "node src/infrastructure/alert-handoff-command.ts",
    "ops:evidence": "node src/infrastructure/alert-evidence-command.ts",
    "jobs:notion": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/persistence/notion-job-command.ts",
    "drain:notifications": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/persistence/notification-drain.ts",
    "maintenance": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/persistence/maintenance.ts",
    "test:unit": "node ../../scripts/test.ts api-unit",
    "test:integration": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local ../../scripts/test.ts api-integration",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "pinyin-pro": "3.29.5",
    "postgres": "4.1.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
