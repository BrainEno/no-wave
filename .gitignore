node_modules/
*.tsbuildinfo
.pnpm-store/
.next/
out/
# React Router prototype build output and generated route types
apps/web-rr/build/
apps/web-rr/.react-router/
dist/
coverage/
.env
.env.*
!.env.example
.DS_Store

# Neon CLI project context (organization, project and branch IDs)
.neon
.neon/

# Playwright browser-level test output
test-results/
playwright-report/
blob-report/

# Local SQLite data and write-ahead log files
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Notion seed: local run state and captured bundles (content, not code)
.notion-seed-state.json
notion-bundle.json

# Reproducible font generator: raw upstream download cache and subset caches are never shipped.
.cache/

# Generated first-party font WOFF2 subsets are produced at build time
# (pnpm fonts:generate) and must not be committed. Only the source receipts,
# manifest and original OFL licenses are tracked.
packages/web-ui/src/styles/fonts/*.woff2
packages/web-ui/src/styles/.font-staging-*/
